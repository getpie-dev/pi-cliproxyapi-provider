{
  "name": "@getpie/pi-cliproxyapi-provider",
  "version": "0.1.0",
  "description": "Minimal CLIProxyAPI provider for Pi using official @earendil-works/pi-ai Codex WebSocket transport",
  "type": "module",
  "license": "MIT",
  "author": "oxwen11",
  "repository": {
    "type": "git",
    "url": "https://github.com/getpie-dev/pi-cliproxyapi-provider"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "cliproxyapi"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.15.21",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
